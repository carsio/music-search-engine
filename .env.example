# Copie os valores para seu ambiente local e substitua pelos dados reais.
# O arquivo .env local fica ignorado pelo Git.

# LLM OpenAI-compativel usada para enrichment, classificacao de intent e rerank.
NIM_API_KEY=replace-with-your-api-key
NIM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
NIM_MODEL_EXTRACT=nim-coder
NIM_MODEL_INTENT=nim-gemma-4-31b-it
NIM_MODEL_RERANK=nim-qwen3-next-80b
NIM_TIMEOUT=60
NIM_RATE=1.0
NIM_MAX_RETRIES=4
NIM_RETRY_BASE=1.0
NIM_RETRY_CAP=30.0
NIM_RETRY_JITTER=0.25

# Fontes opcionais de letras.
VAGALUME_API_KEY=replace-with-your-vagalume-key
GENIUS_TOKEN=replace-with-your-genius-token

# Embeddings vetoriais opcionais.
USE_OLLAMA=true
OPENAI_API_KEY=replace-with-your-openai-key
