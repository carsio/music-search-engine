{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: dev",
      "type": "shell",
      "command": "uv run uvicorn music_search.web.app:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      },
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": [
          {
            "regexp": "^(.*)$",
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Started server process.*|.*Waiting for application startup.*",
          "endsPattern": ".*Application startup complete.*"
        }
      }
    },
    {
      "label": "backend: prepare search artifacts",
      "type": "shell",
      "command": "uv run python -m music_search.scripts.prepare_search_artifacts",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "backend: ready",
      "dependsOn": ["backend: prepare search artifacts", "backend: dev"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "frontend: ensure deps",
      "type": "shell",
      "command": "if [ ! -x node_modules/.bin/vite ]; then npm install; fi",
      "windows": {
        "command": "if (-not (Test-Path 'node_modules/.bin/vite.cmd')) { npm install }"
      },
      "linux": {
        "command": "if [ ! -x node_modules/.bin/vite ]; then npm install; fi"
      },
      "osx": {
        "command": "if [ ! -x node_modules/.bin/vite ]; then npm install; fi"
      },
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "dependsOn": ["frontend: ensure deps"],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": [
          {
            "regexp": "^(.*)$",
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE v.*",
          "endsPattern": ".*Local:.*"
        }
      }
    },
    {
      "label": "dev: full stack",
      "dependsOn": ["backend: ready", "frontend: dev"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
